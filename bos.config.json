{
  "extends": "bos://dev.everything.near/dev.everything.dev",
  "account": "nearbuilding.near",
  "domain": "activity.nearbuilders.org",
  "title": "Activity | NearBuilders",
  "description": "Shared activity and reputation layer for the NEAR ecosystem — Activity Sources submit signed events through one HTTP gateway; Nostr relays store and distribute them.",
  "repository": "https://github.com/NEARBuilders/activity.nearbuilders.org",
  "ci": {
    "railway": {
      "service": "activity-app"
    }
  },
  "app": {
    "ui": {
      "development": "local:ui",
      "production": "https://elliot-braem-7908-ui-activity-nearbuilders-org-ne-cce9505dc-ze.zephyrcloud.app",
      "integrity": "sha384-zxm5jXUCmxG+AUqyC4jcd+B+SvKjutw+iom2hJsJCKF06+8b+m3cpOuslrmF/sbK"
    },
    "api": {
      "development": "local:api",
      "variables": {
        "activityNostrBindingContract": "contextual.near",
        "activityNostrBindingRelay": "wss://relay.nearbuilders.org",
        "activityNostrKvApiUrl": "https://kv.main.fastnear.com",
        "activityRelayUrl": "wss://relay.nearbuilders.org"
      },
      "secrets": [
        "API_DATABASE_URL",
        "ACTIVITY_SIGNING_MASTER_KEYS",
        "ACTIVITY_SIGNING_ACTIVE_KEY_VERSION",
        "ACTIVITY_REDIS_URL"
      ]
    }
  },
  "plugins": {
    "nostr": {
      "extends": "bos://nearbuilding.near/nostr.nearbuilders.org",
      "variables": {
        "clientName": "activity.nearbuilders.org"
      }
    }
  }
}
