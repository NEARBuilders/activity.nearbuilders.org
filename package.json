{
  "name": "monorepo",
  "private": true,
  "scripts": {
    "predev": "pnpm run compose:doctor",
    "dev": "bos dev",
    "dev:ui": "bos dev --ui local --api remote",
    "dev:api": "bos dev --ui remote --api local",
    "dev:proxy": "bos dev --proxy",
    "dev:activity-infra": "docker compose -f compose.activity.yml up -d --wait",
    "dev:activity-infra:down": "docker compose -f compose.activity.yml down",
    "first-run": "tsx scripts/first-run.ts",
    "setup:check": "tsx scripts/setup-check.ts",
    "compose:doctor": "tsx scripts/compose-doctor.ts",
    "seed:demo": "tsx scripts/seed-demo-data.ts",
    "docs:sync": "tsx scripts/sync-docs.ts",
    "keys:gen": "tsx scripts/keys-gen.ts",
    "build": "bos build",
    "deploy": "bos deploy",
    "publish": "bos publish",
    "bos": "bos",
    "types:gen": "bos types gen",
    "typecheck": "pnpm run types:gen && if [ -d ui ]; then pnpm --dir ui run typecheck; fi && if [ -d api ]; then pnpm --dir api run typecheck; fi && if [ -d plugins ]; then for dir in plugins/*; do if [ -f \"$dir/package.json\" ]; then pnpm --dir \"$dir\" --if-present run typecheck && pnpm --dir \"$dir\" --if-present run typecheck:ui; fi; done; fi",
    "typecheck:examples": "tsc --noEmit -p examples/tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "start": "bos start",
    "db:push": "pnpm --dir api exec drizzle-kit push",
    "db:studio": "bos db:studio",
    "db:generate": "pnpm --dir api exec drizzle-kit generate",
    "db:migrate": "pnpm --dir api exec drizzle-kit migrate",
    "test": "pnpm --dir api --if-present run test && pnpm --dir ui --if-present run test && if [ -d plugins ]; then for d in plugins/*; do if [ -f \"$d/package.json\" ]; then pnpm --dir \"$d\" --if-present run test; fi; done; fi",
    "test:api": "pnpm --dir api --if-present run test",
    "test:integration": "pnpm --dir api --if-present run test tests/integration/",
    "test:integration-guide": "pnpm --dir api test tests/integration/activity-client-example.test.ts",
    "test:activity": "pnpm run dev:activity-infra && ACTIVITY_INTEGRATION=1 pnpm --dir api test tests/integration/activity-boundary.test.ts",
    "benchmark:leaderboard": "pnpm run dev:activity-infra && tsx api/benchmarks/activity-leaderboard.ts",
    "dev:postgres": "docker compose up -d --wait && pnpm run dev",
    "dev:postgres:down": "docker compose down",
    "dev:postgres:reset": "docker compose down -v && docker compose up -d --wait",
    "db:doctor": "bos db:doctor",
    "db:repair": "bos db:repair",
    "test:scripts": "vitest run scripts"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@changesets/cli": "^2.29.8",
    "@types/pg": "catalog:",
    "dotenv": "^17.3.1",
    "github-slugger": "^2.0.0",
    "tsx": "^4.21.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "catalog:",
    "yaml": "catalog:",
    "@effect/tsgo": "^0.63.0",
    "@playwright/test": "^1.58.1",
    "@shadcn/lint": "^0.2.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005"
  },
  "dependencies": {
    "@better-auth/api-key": "catalog:",
    "@better-auth/core": "catalog:",
    "@better-auth/passkey": "catalog:",
    "@libsql/client": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/server": "catalog:",
    "better-auth": "catalog:",
    "better-near-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "@electric-sql/pglite": "catalog:",
    "effect": "catalog:",
    "zod": "catalog:",
    "@opentelemetry/api": "catalog:",
    "every-plugin": "catalog:",
    "everything-dev": "catalog:",
    "@effect/oxc": "link:repos/effect/packages/tools/oxc"
  },
  "patchedDependencies": {
    "everything-dev@1.53.2": "patches/everything-dev@1.53.2.patch"
  },
  "peerDependencies": {
    "typescript": "catalog:"
  }
}
