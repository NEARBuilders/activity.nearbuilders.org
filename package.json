{
  "name": "monorepo",
  "private": true,
  "scripts": {
    "predev": "pnpm run compose:doctor",
    "dev": "bos dev",
    "dev:ui": "bos dev --ui local --api remote",
    "dev:api": "bos dev --ui remote --api local",
    "dev:proxy": "bos dev --proxy",
    "dev:activity-infra": "docker compose -f compose.activity.yml up -d --wait",
    "dev:activity-infra:down": "docker compose -f compose.activity.yml down",
    "first-run": "pnpm run scripts/first-run.ts",
    "setup:check": "pnpm run scripts/setup-check.ts",
    "compose:doctor": "pnpm run scripts/compose-doctor.ts",
    "seed:demo": "pnpm run scripts/seed-demo-data.ts",
    "docs:sync": "pnpm run scripts/sync-docs.ts",
    "keys:gen": "pnpm run scripts/keys-gen.ts",
    "build": "bos build",
    "deploy": "bos deploy",
    "publish": "bos publish",
    "bos": "bos",
    "types:gen": "bos types gen",
    "typecheck": "pnpm run types:gen && if [ -d ui ]; then pnpm --dir ui run typecheck; fi && if [ -d api ]; then pnpm --dir api run typecheck; fi && for dir in packages/*; do if [ -f \"$dir/package.json\" ]; then pnpm --dir \"$dir\" --if-present run typecheck || exit 1; fi; done",
    "typecheck:examples": "tsc --noEmit -p examples/tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "start": "bos start",
    "changeset": "changeset",
    "postinstall": "bos types gen || true",
    "version": "changeset version",
    "release": "echo 'Packages versioned - app release handled by workflow'",
    "db:push": "pnpm --dir api exec drizzle-kit push",
    "db:studio": "bos db:studio",
    "db:generate": "pnpm --dir api exec drizzle-kit generate",
    "db:migrate": "pnpm --dir api exec drizzle-kit migrate",
    "test": "pnpm --dir api --if-present run test && pnpm --dir ui --if-present run test && for dir in packages/*; do if [ -f \"$dir/package.json\" ]; then pnpm --dir \"$dir\" --if-present run test || exit 1; fi; done",
    "test:api": "pnpm --dir api --if-present run test",
    "test:integration": "pnpm --dir api --if-present run test tests/integration/",
    "test:integration-guide": "pnpm --dir api test tests/integration/activity-client-example.test.ts",
    "test:activity": "pnpm run dev:activity-infra && ACTIVITY_INTEGRATION=1 pnpm --dir api test tests/integration/activity-boundary.test.ts",
    "benchmark:leaderboard": "pnpm run dev:activity-infra && bun api/benchmarks/activity-leaderboard.ts",
    "regression:start:dev": "BOS_NO_PERSIST_PORTS=1 bun packages/everything-dev/src/cli.ts dev --no-interactive --port 4100 --api-port 4101 --auth-port 4102 --ui-port 4103 --plugin-port-start 4110",
    "regression:start:prod": "BOS_NO_PERSIST_PORTS=1 PORT=4100 bun ./node_modules/everything-dev/dist/cli.mjs start --no-interactive",
    "test:regression:http:dev": "REGRESSION_MODE=dev sh -lc 'cd tests/regression/http && go test ./... -count=1 -v -timeout 10m'",
    "test:regression:http:prod": "REGRESSION_MODE=prod sh -lc 'cd tests/regression/http && go test ./... -count=1 -v -timeout 10m'",
    "test:regression:browser:install": "bunx playwright install --with-deps chromium",
    "test:regression:browser:dev": "REGRESSION_MODE=dev bunx playwright test -c tests/regression/browser/playwright.config.mjs --project=dev",
    "test:regression:browser:prod": "REGRESSION_MODE=prod bunx playwright test -c tests/regression/browser/playwright.config.mjs --project=prod",
    "test:regression:dev": "pnpm run test:regression:http:dev && pnpm run test:regression:browser:dev",
    "test:regression:prod": "pnpm run test:regression:http:prod && pnpm run test:regression:browser:prod",
    "test:regression": "pnpm run test:regression:dev",
    "dev:postgres": "docker compose up -d --wait && pnpm run dev",
    "dev:postgres:down": "docker compose down",
    "dev:postgres:reset": "docker compose down -v && docker compose up -d --wait",
    "db:doctor": "bos db:doctor",
    "db:repair": "bos db:repair"
  },
  "packageManager": "pnpm@12.10.1",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@changesets/cli": "^2.29.8",
    "@playwright/test": "^1.58.1",
    "@types/bun": "latest",
    "@types/pg": "catalog:",
    "dotenv": "^17.3.1",
    "github-slugger": "^2.0.0",
    "tsx": "^4.21.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@better-auth/api-key": "catalog:",
    "@better-auth/core": "catalog:",
    "@better-auth/passkey": "catalog:",
    "@libsql/client": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/server": "catalog:",
    "better-auth": "catalog:",
    "better-near-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "@electric-sql/pglite": "catalog:",
    "effect": "catalog:",
    "zod": "catalog:",
    "@opentelemetry/api": "catalog:",
    "every-plugin": "catalog:",
    "everything-dev": "catalog:"
  },
  "patchedDependencies": {
    "everything-dev@1.53.2": "patches/everything-dev@1.53.2.patch"
  }
}
