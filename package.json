{
  "name": "monorepo",
  "private": true,
  "workspaces": {
    "packages": [
      "api",
      "ui"
    ],
    "catalog": {
      "react": "19.2.4",
      "react-dom": "19.2.4",
      "@tanstack/react-query": "5.90.20",
      "@tanstack/react-query-devtools": "^5.91.1",
      "@tanstack/react-router": "1.157.16",
      "@tanstack/react-router-devtools": "1.157.16",
      "@tanstack/router-plugin": "1.157.16",
      "@tanstack/react-devtools": "^0.10.1",
      "@tanstack/react-form": "^1.29.1",
      "@tanstack/zod-form-adapter": "^0.42.1",
      "near-kit": "^0.14.0",
      "@scure/base": "^2.2.0",
      "drizzle-orm": "^0.45.1",
      "drizzle-kit": "^0.31.8",
      "better-auth": "1.6.25",
      "@better-auth/api-key": "1.6.25",
      "@better-auth/passkey": "1.6.25",
      "better-near-auth": "1.10.1",
      "every-plugin": "^2.10.1",
      "everything-dev": "^1.53.2",
      "typescript": "^5.9.3",
      "vitest": "^4.1.8",
      "@libsql/client": "0.17.0",
      "pg": "^8.12.0",
      "@types/pg": "^8.11.6",
      "@electric-sql/pglite": "^0.4.5",
      "@types/node": "^25.0.3",
      "@types/react": "^19.2.7",
      "@types/react-dom": "^19.2.3",
      "effect": "3.21.2",
      "zod": "4.4.3",
      "@orpc/contract": "1.14.3",
      "@orpc/server": "1.14.3",
      "@orpc/client": "1.14.3",
      "@orpc/openapi": "1.14.3",
      "@orpc/tanstack-query": "1.14.3",
      "@module-federation/enhanced": "^2.4.0",
      "@module-federation/node": "^2.7.42",
      "@module-federation/rsbuild-plugin": "^2.4.0",
      "@opentelemetry/api": "^1.9.0",
      "@rspack/core": "1.7.11",
      "@rspack/cli": "1.7.11",
      "@rsbuild/core": "1.7.5",
      "@rsbuild/plugin-react": "1.4.6",
      "zephyr-rspack-plugin": "^1.1.2",
      "zephyr-rsbuild-plugin": "^1.1.2",
      "@better-auth/core": "1.6.25"
    }
  },
  "scripts": {
    "dev": "bos dev",
    "dev:ui": "bos dev --ui local --api remote",
    "dev:api": "bos dev --ui remote --api local",
    "dev:proxy": "bos dev --proxy",
    "dev:activity-infra": "docker compose -f compose.activity.yml up -d --wait",
    "dev:activity-infra:down": "docker compose -f compose.activity.yml down",
    "build": "bos build",
    "deploy": "bos build --deploy",
    "publish": "bos publish",
    "bos": "bos",
    "types:gen": "node node_modules/.bin/bos types gen",
    "typecheck": "bun run types:gen && if [ -d ui ]; then bun run --cwd ui typecheck; fi && if [ -d api ]; then bun run --cwd api typecheck; fi && bun run typecheck:examples",
    "typecheck:examples": "tsc --noEmit -p examples/tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "start": "bos start",
    "changeset": "changeset",
    "postinstall": "node node_modules/.bin/bos types gen || true",
    "version": "changeset version",
    "release": "echo 'Packages versioned - app release handled by workflow'",
    "db:push": "bun run --cwd api drizzle-kit push",
    "db:studio": "bos db:studio",
    "db:generate": "bun run --cwd api drizzle-kit generate",
    "db:migrate": "bun run --cwd api drizzle-kit migrate",
    "test": "bun run --cwd api test && bun run --cwd ui test",
    "test:api": "bun run --cwd api test",
    "test:integration": "bun run --cwd api test tests/integration/",
    "test:integration-guide": "bun run --cwd api test tests/integration/activity-client-example.test.ts",
    "test:activity": "bun run dev:activity-infra && ACTIVITY_INTEGRATION=1 bun run --cwd api test tests/integration/activity-boundary.test.ts",
    "benchmark:leaderboard": "bun run dev:activity-infra && bun api/benchmarks/activity-leaderboard.ts",
    "dev:postgres": "docker compose up -d --wait && bun run dev",
    "dev:postgres:down": "docker compose down",
    "dev:postgres:reset": "docker compose down -v && docker compose up -d --wait",
    "db:doctor": "bos db:doctor",
    "db:repair": "bos db:repair"
  },
  "packageManager": "bun@1.3.14",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@changesets/cli": "^2.29.8",
    "@types/bun": "latest",
    "dotenv": "^17.3.1",
    "@types/pg": "catalog:",
    "tsx": "^4.21.0",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@better-auth/api-key": "catalog:",
    "@better-auth/core": "catalog:",
    "@better-auth/passkey": "catalog:",
    "@libsql/client": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/server": "catalog:",
    "better-auth": "catalog:",
    "better-near-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "@electric-sql/pglite": "catalog:",
    "effect": "catalog:",
    "zod": "catalog:",
    "@opentelemetry/api": "catalog:",
    "every-plugin": "catalog:",
    "everything-dev": "catalog:"
  },
  "patchedDependencies": {
    "everything-dev@1.53.2": "patches/everything-dev@1.53.2.patch"
  }
}
