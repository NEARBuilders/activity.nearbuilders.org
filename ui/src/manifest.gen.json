{
  "name": "ui",
  "manifestVersion": 2,
  "routes": [
    {
      "id": "_authenticated",
      "type": "layout",
      "mount": "authenticated",
      "file": "_authenticated.tsx"
    },
    {
      "id": "_public",
      "type": "layout",
      "mount": "public",
      "file": "_public.tsx"
    },
    {
      "id": "_authenticated/activity-sources",
      "type": "route",
      "path": "/activity-sources",
      "parentId": "_authenticated",
      "file": "_authenticated/activity-sources.tsx"
    },
    {
      "id": "_authenticated/admin",
      "type": "route",
      "path": "/admin",
      "parentId": "_authenticated",
      "file": "_authenticated/admin.tsx"
    },
    {
      "id": "_authenticated/binding",
      "type": "route",
      "path": "/binding",
      "parentId": "_authenticated",
      "file": "_authenticated/binding.tsx"
    },
    {
      "id": "_authenticated/home",
      "type": "route",
      "path": "/home",
      "parentId": "_authenticated",
      "file": "_authenticated/home.tsx"
    },
    {
      "id": "_authenticated/settings",
      "type": "route",
      "path": "/settings",
      "parentId": "_authenticated",
      "file": "_authenticated/settings.tsx"
    },
    {
      "id": "_authenticated/tenants",
      "type": "route",
      "path": "/tenants",
      "parentId": "_authenticated",
      "file": "_authenticated/tenants.tsx"
    },
    {
      "id": "_public/about",
      "type": "route",
      "path": "/about",
      "parentId": "_public",
      "file": "_public/about.tsx"
    },
    {
      "id": "_public/activity",
      "type": "route",
      "path": "/activity",
      "parentId": "_public",
      "file": "_public/activity.tsx"
    },
    {
      "id": "_public/login",
      "type": "route",
      "path": "/login",
      "parentId": "_public",
      "file": "_public/login.tsx"
    },
    {
      "id": "_public/skill",
      "type": "route",
      "path": "/skill",
      "parentId": "_public",
      "file": "_public/skill.tsx"
    },
    {
      "id": "_public/",
      "type": "index",
      "path": "/",
      "parentId": "_public",
      "file": "_public/index.tsx"
    },
    {
      "id": "_authenticated/accept-invitation/$id",
      "type": "route",
      "path": "/accept-invitation/$id",
      "parentId": "_authenticated",
      "file": "_authenticated/accept-invitation.$id.tsx"
    },
    {
      "id": "_authenticated/organizations/$slug",
      "type": "route",
      "path": "/organizations/$slug",
      "parentId": "_authenticated",
      "file": "_authenticated/organizations/$slug.tsx"
    },
    {
      "id": "_authenticated/organizations/new",
      "type": "route",
      "path": "/organizations/new",
      "parentId": "_authenticated",
      "file": "_authenticated/organizations/new.tsx"
    },
    {
      "id": "_authenticated/settings/auth-methods",
      "type": "route",
      "path": "/auth-methods",
      "parentId": "_authenticated/settings",
      "file": "_authenticated/settings/auth-methods.tsx"
    },
    {
      "id": "_authenticated/settings/profile",
      "type": "route",
      "path": "/profile",
      "parentId": "_authenticated/settings",
      "file": "_authenticated/settings/profile.tsx"
    },
    {
      "id": "_authenticated/settings/security",
      "type": "route",
      "path": "/security",
      "parentId": "_authenticated/settings",
      "file": "_authenticated/settings/security.tsx"
    },
    {
      "id": "_authenticated/tenant/$tenantId",
      "type": "route",
      "path": "/tenant/$tenantId",
      "parentId": "_authenticated",
      "file": "_authenticated/tenant/$tenantId.tsx"
    },
    {
      "id": "_authenticated/tenant/new",
      "type": "route",
      "path": "/tenant/new",
      "parentId": "_authenticated",
      "file": "_authenticated/tenant/new.tsx"
    },
    {
      "id": "_public/docs/$slug",
      "type": "route",
      "path": "/docs/$slug",
      "parentId": "_public",
      "file": "_public/docs/$slug.tsx"
    },
    {
      "id": "_authenticated/organizations/",
      "type": "route",
      "path": "/organizations/",
      "parentId": "_authenticated",
      "file": "_authenticated/organizations/index.tsx"
    },
    {
      "id": "_authenticated/settings/",
      "type": "index",
      "path": "/",
      "parentId": "_authenticated/settings",
      "file": "_authenticated/settings/index.tsx"
    },
    {
      "id": "_public/docs/",
      "type": "route",
      "path": "/docs/",
      "parentId": "_public",
      "file": "_public/docs/index.tsx"
    }
  ]
}
